LAMMPS (29 Sep 2021)
# Molecular dynamics simulation

units           metal
boundary        p p p
atom_style      atomic

neighbor        2.0 bin
neigh_modify    every 10 delay 0 check no

read_data       /work/wangs/Django-deepmd/mysite_deepmd/demo001/lammps/md_sys/water_copy.lmp
Reading data file ...
  triclinic box = (0.0000000 0.0000000 0.0000000) to (12.444700 12.444700 12.444700) with tilt (0.0000000 0.0000000 0.0000000)
  1 by 1 by 1 MPI processor grid
  reading atoms ...
  192 atoms
  read_data CPU = 0.001 seconds
mass            1 16    # O
mass            2 2    # H

# 定义原子组
group       O  type 1
64 atoms in group O
group       H  type 2
128 atoms in group H

pair_style      deepmd  /work/wangs/Django-deepmd/mysite_deepmd/demo001/lammps/model/water/water.pb
pair_coeff      * * O H

velocity        all create 330.0 23456789

fix             1 all nvt temp 330.0 330.0 0.5
timestep        0.0005
thermo_style    custom step pe ke etotal temp press vol
thermo          100

#输出轨迹
dump            1 all custom 100 /work/wangs/Django-deepmd/mysite_deepmd/demo001/lammps/output/dump/Dump.dump id type x y z

#输出力
compute myForce all property/atom fx fy fz
dump 2 all custom 100 /work/wangs/Django-deepmd/mysite_deepmd/demo001/lammps/output/force/Force.dump id type c_myForce[1] c_myForce[2] c_myForce[3]

#输出RDF
compute rdf all rdf 100 1 1 1 2 2 2
fix 2 all ave/time 100 1 100 c_rdf[*] file /work/wangs/Django-deepmd/mysite_deepmd/demo001/lammps/output/rdf/RDF.rdf mode vector

run             100

