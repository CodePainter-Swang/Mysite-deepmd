# bulk cu

units           metal
boundary        p p p
atom_style      atomic

neighbor        2.0 bin
neigh_modify    every 50 delay 0 check no

read_data	copper.lmp
group       Cu  type 1

mass 		1 63.546

# pair_style deepmd fathergraph.pb graph.pb out_file graph.out out_freq 10 atomic relative 1.0
pair_style  deepmd CuFatherTanh2048-D-FP32.pb
pair_coeff * * Cu

velocity        all create 330.0 23456789

fix             1 all nve
timestep        0.0005
thermo_style    custom step pe ke etotal temp press vol
thermo          100
dump 1 all custom 100 CuFp32_D.dump id type x y z 

#输出力
compute myForce all property/atom fx fy fz
dump 2 all custom 100 CuFp32_D_forces.dump id type c_myForce[1] c_myForce[2] c_myForce[3]

compute rdf all rdf 100 1 1 
fix 2 all ave/time 100 1 100 c_rdf[*] file CuFp32_D.rdf mode vector

run 10000
# run 100000

# MPI 并发推理 LAMMPS
# mpiexec --allow-run-as-root -n 4 ./lmp_serial -in in.lammps



#输出轨迹
dump            1 all custom 100 /work/wangs/Django-deepmd/mysite_deepmd/demo001/lammps/output/dump/Dump.dump id type x y z

#输出力
compute myForce all property/atom fx fy fz
dump 2 all custom 100 /work/wangs/Django-deepmd/mysite_deepmd/demo001/lammps/output/force/Force.dump id type c_myForce[1] c_myForce[2] c_myForce[3]

#输出RDF
compute rdf all rdf 100 1 1 
fix 2 all ave/time 100 1 100 c_rdf[*] file /work/wangs/Django-deepmd/mysite_deepmd/demo001/lammps/output/rdf/RDF.rdf mode vector